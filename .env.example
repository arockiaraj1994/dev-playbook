# Copy to .env and edit. Only MCP_ADMIN_PASSWORD is required.

# Required: the container binds 0.0.0.0 internally, and the server refuses to
# start on the literal admin/admin pair. Compose publishes the port to
# 127.0.0.1 only, so a weak password stays on this machine - if you change the
# publish address to 0.0.0.0, use a strong password.
MCP_ADMIN_PASSWORD=change-me

# Optional overrides (defaults shown).
# MCP_ADMIN_USER=admin
# MCP_PORT=8420   # host port (serves both MCP and UI); container always listens on 3000
# MCP_SERVER_LABEL=dev-playbook
# MCP_INACTIVE_DAYS=2

# --- Optional Postgres backend (Redmine #382) ---------------------------------
# INERT until that backend lands: the server is SQLite-only today and does not
# yet read DB_BACKEND/DATABASE_URL. Uncommenting these only starts the DB
# container; it won't be used until #382 is implemented.
# COMPOSE_PROFILES=postgres   # start the postgres service on `docker compose up`
# DB_BACKEND=postgres         # point the server at Postgres instead of SQLite
# PG_PASSWORD=change-me        # Postgres password (defaults to "playbook" if unset)
# PG_PORT=8432                 # host port for Postgres (loopback only)
