# Copy to .env and edit. Only MCP_ADMIN_PASSWORD is required.

# Required: the container binds 0.0.0.0, and the server refuses to start with
# the default admin/admin credentials on a non-loopback bind.
MCP_ADMIN_PASSWORD=change-me

# Optional overrides (defaults shown).
# MCP_ADMIN_USER=admin
# MCP_PORT=3001   # host port; container always listens on 3000
# MCP_SERVER_LABEL=dev-playbook
# MCP_INACTIVE_DAYS=2
# MCP_SNIPPET_SIZE=300
# MCP_REQUIREMENTS_TTL=300
